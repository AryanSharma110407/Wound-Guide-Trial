# Choose exactly one active provider at a time.
# groq = Groq Cloud / GPT-OSS 120B
# omniroute = local OmniRoute OpenAI-compatible endpoint

LLM_PROVIDER=groq

# =========================
# Groq Cloud
# =========================

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b


# =========================
# OmniRoute
# =========================

OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto


# =========================
# ML Model
# =========================

MODEL_PATH=models/best_wound_model_finetuned.pth
MAX_IMAGE_MB=10